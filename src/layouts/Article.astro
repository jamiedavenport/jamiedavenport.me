---
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Portrait from "@/components/Portrait.astro";
import { author } from "@/lib/site";
import { formatDate, postURL } from "@/lib/blog";
import "@/styles/prose.css";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, publishedAt, updatedAt, draft } = post.data;
---

<Layout
  editorial
  title={`${title} | ${author.name}`}
  description={description}
  canonicalPath={postURL(post.id)}
  noindex={draft}
  article={{ title, publishedAt, updatedAt }}
>
  <div class="py-16 tracking-[-0.015em] sm:py-24">
    <article class="mx-auto w-full max-w-[calc(65ch+3rem)] px-6 text-base/7 sm:text-sm/6.5">
      <header class="mb-12">
        {draft && <p class="mb-4 text-base/7 text-zinc-500 sm:text-sm/6.5">Draft preview</p>}
        <h1 class="text-3xl font-semibold tracking-tight text-pretty text-zinc-900 sm:text-4xl">{title}</h1>
        <p class="mt-5 text-pretty text-zinc-600">{description}</p>
        <div class="mt-7 flex items-center gap-3">
          <a
            class="shrink-0 rounded-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-800"
            href="/"
            aria-label="Jamie Davenport — home"
          >
            <Portrait small />
          </a>
          <div class="min-w-0 text-base/6 sm:text-sm/6">
            <p class="font-medium text-zinc-800">{author.name}</p>
            <p class="text-zinc-500">
              <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
              {updatedAt && (
                <span> · Updated <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time></span>
              )}
            </p>
          </div>
        </div>
      </header>
      <div class="prose prose-zinc article-prose max-w-[65ch] text-base/7 wrap-anywhere sm:prose-sm sm:text-sm/6.5 prose-headings:font-semibold prose-headings:text-pretty prose-a:underline-offset-4 prose-strong:font-semibold prose-blockquote:font-normal prose-blockquote:not-italic prose-code:font-normal prose-pre:rounded-lg prose-pre:border prose-pre:border-zinc-950/10 prose-pre:bg-white prose-th:whitespace-nowrap">
        <slot />
      </div>
      <div class="mt-14 text-base/7 text-zinc-500 sm:text-sm/6.5">
        <a class="no-underline hover:text-zinc-950 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-800" href="/">Back home</a>
      </div>
    </article>
  </div>
</Layout>
