---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { author } from "@/lib/site";

interface Props {
  title?: string;
  description?: string;
  editorial?: boolean;
  noindex?: boolean;
  canonicalPath?: string;
  article?: {
    title: string;
    publishedAt: Date;
    updatedAt?: Date;
  };
}

const {
  title = "Jamie Davenport | Software Engineer & Founder",
  description = author.description,
  editorial = false,
  noindex = false,
  canonicalPath = Astro.url.pathname,
  article,
} = Astro.props;

const canonicalURL = new URL(canonicalPath, Astro.site);
const homeURL = new URL("/", Astro.site).href;
const portraitURL = new URL(author.portrait, Astro.site).href;
const isHome = Astro.url.pathname === "/";
const contentFade = {
  old: { name: "content-fade-out", duration: "140ms", easing: "ease-in", fillMode: "both" },
  new: { name: "content-fade-in", duration: "160ms", delay: "140ms", easing: "ease-out", fillMode: "both" },
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${homeURL}#website`,
      url: homeURL,
      name: author.name,
      inLanguage: "en-GB",
      publisher: { "@id": `${homeURL}#person` },
    },
    ...(isHome ? [{
      "@type": "ProfilePage",
      "@id": `${homeURL}#profile`,
      url: homeURL,
      name: title,
      description,
      inLanguage: "en-GB",
      isPartOf: { "@id": `${homeURL}#website` },
      mainEntity: { "@id": `${homeURL}#person` },
    }] : []),
    ...(article ? [{
      "@type": "BlogPosting",
      "@id": `${canonicalURL.href}#article`,
      url: canonicalURL.href,
      headline: article.title,
      description,
      datePublished: article.publishedAt.toISOString(),
      dateModified: (article.updatedAt ?? article.publishedAt).toISOString(),
      inLanguage: "en-GB",
      author: { "@id": `${homeURL}#person` },
      publisher: { "@id": `${homeURL}#person` },
      isPartOf: { "@id": `${homeURL}#website` },
      mainEntityOfPage: canonicalURL.href,
    }] : []),
    {
      "@type": "Person",
      "@id": `${homeURL}#person`,
      name: author.name,
      givenName: author.givenName,
      familyName: author.familyName,
      url: homeURL,
      image: portraitURL,
      description: author.description,
      jobTitle: "Software engineer",
      homeLocation: { "@type": "City", name: "London" },
      worksFor: { "@type": "Organization", name: "JXD", url: "https://jxd.dev/" },
      sameAs: author.sameAs,
    },
  ],
};
---

<!doctype html>
<html lang="en-GB" transition:animate="none">
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={author.name} />
    <meta name="theme-color" content="#fdfdfc" />
    <meta name="color-scheme" content="light" />
    <meta
      name="robots"
      content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"}
    />
    {!noindex && (
      <>
        <link rel="canonical" href={canonicalURL} />
        <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
        <meta property="og:type" content={article ? "article" : isHome ? "profile" : "website"} />
        <meta property="og:site_name" content={author.name} />
        <meta property="og:locale" content="en_GB" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalURL} />
        {isHome && (
          <>
            <meta property="og:image" content={portraitURL} />
            <meta property="og:image:type" content="image/png" />
            <meta property="og:image:width" content="1254" />
            <meta property="og:image:height" content="1254" />
            <meta property="og:image:alt" content={author.portraitAlt} />
            <meta property="profile:first_name" content={author.givenName} />
            <meta property="profile:last_name" content={author.familyName} />
            <meta name="twitter:image" content={portraitURL} />
            <meta name="twitter:image:alt" content={author.portraitAlt} />
          </>
        )}
        {article && (
          <>
            <meta property="article:author" content={homeURL} />
            <meta property="article:published_time" content={article.publishedAt.toISOString()} />
            {article.updatedAt && <meta property="article:modified_time" content={article.updatedAt.toISOString()} />}
          </>
        )}
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
        />
      </>
    )}
    <link rel="icon" type="image/png" href={author.portrait} />
    <link rel="apple-touch-icon" href={author.portrait} />
    <link
      rel="preload"
      href="/fonts/InterVariable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-[#fdfdfc] font-sans text-zinc-950 antialiased">
    <main
      class:list={[
        "isolate outline-none",
        !editorial && "mx-auto flex min-h-dvh max-w-2xl flex-col justify-center px-6 py-20 sm:px-10",
      ]}
      tabindex="-1"
      transition:name="page-content"
      transition:animate={{ forwards: contentFade, backwards: contentFade }}
    >
      <slot />
    </main>
    <script>
      import { OpenPanel } from "@openpanel/web";

      document.addEventListener("astro:before-preparation", () => {
        const portrait = document.querySelector<HTMLElement>("[data-portrait]");
        if (!portrait) {
          return;
        }
        const bounds = portrait.getBoundingClientRect();
        // An off-screen portrait has no useful snapshot to morph from.
        if (bounds.bottom <= 0 || bounds.top >= window.innerHeight) {
          portrait.style.viewTransitionName = "none";
        }
      });

      document.addEventListener("astro:after-swap", () => {
        const destination = window.location.hash === "#writing"
          ? document.getElementById("writing")
          : document.querySelector<HTMLElement>("main");
        destination?.focus({ preventScroll: true });
      });

      document.addEventListener("astro:page-load", () => {
        document.querySelector<HTMLElement>("[data-portrait]")?.style.removeProperty("view-transition-name");
      });

      if (import.meta.env.PROD) {
        const analytics = new OpenPanel({
          clientId: "9b856dbc-28e4-492d-a7f7-9b6ca082d026",
          trackScreenViews: false,
          trackOutgoingLinks: true,
        });
        document.addEventListener("astro:page-load", () => {
          analytics.screenView(`${window.location.origin}${window.location.pathname}${window.location.search}`);
        });
      }
    </script>
  </body>
</html>
