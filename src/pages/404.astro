---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found | Jamie Davenport"
  description="This page could not be found."
>
  <p class="mb-6 text-sm text-stone-500">404</p>
  <h1 class="text-4xl font-semibold tracking-tight">Page not found</h1>
  <p class="mt-6 text-lg text-stone-600">There’s nothing at this address.</p>
  <a
    href="/"
    class="mt-10 w-fit rounded-sm underline decoration-stone-300 underline-offset-4 hover:decoration-stone-900 focus-visible:outline-2 focus-visible:outline-offset-4"
    >Back to home</a
  >
</Layout>
