---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <p class="mb-6 text-sm text-stone-500">jamiedavenport.me</p>
  <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
    Jamie Davenport
  </h1>
  <p class="mt-6 text-lg leading-relaxed text-stone-600">
    Welcome to my little corner of the internet. More soon.
  </p>
  <nav aria-label="Social links" class="mt-10">
    <a
      href="https://github.com/jamiedavenport"
      class="rounded-sm underline decoration-stone-300 underline-offset-4 hover:decoration-stone-900 focus-visible:outline-2 focus-visible:outline-offset-4"
      >GitHub</a
    >
  </nav>
</Layout>
