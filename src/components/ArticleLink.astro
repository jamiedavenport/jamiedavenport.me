---
interface Props {
  href: string;
}

const { href } = Astro.props;
const external = /^https?:\/\//.test(href);
---

<a
  class="not-prose font-medium text-zinc-800 no-underline hover:text-zinc-950 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-800"
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
>
  <slot />
</a>
