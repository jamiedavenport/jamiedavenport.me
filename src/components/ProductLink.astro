---
interface Props {
  href: string;
  icon: string;
  tilt?: "left" | "right";
}

const { href, icon, tilt = "left" } = Astro.props;
---

<a
  class="not-prose group inline-flex items-baseline gap-1.25 whitespace-nowrap font-medium text-zinc-800 no-underline hover:text-zinc-950 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-zinc-800"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  <img
    class:list={[
      "box-content size-4 shrink-0 self-center rounded border border-zinc-950/12 bg-white p-0.75 object-contain transition-transform duration-180 ease-in-out motion-safe:group-hover:-translate-y-px motion-safe:group-hover:rotate-0 motion-safe:group-focus-visible:-translate-y-px motion-safe:group-focus-visible:rotate-0 motion-reduce:rotate-0 motion-reduce:transition-none",
      tilt === "right" ? "rotate-6" : "-rotate-6",
    ]}
    src={icon}
    alt=""
    width="16"
    height="16"
  />
  <span><slot /></span>
</a>
