---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure>
  <Image
    class="rounded-[min(1vw,8px)] outline-1 -outline-offset-1 outline-zinc-950/10"
    src={src}
    alt={alt}
    layout="constrained"
    width={Math.min(src.width, 1300)}
    loading="lazy"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
